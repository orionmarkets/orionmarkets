# Next.js site for one network (%i = testnet | mainnet). Host, port and env come from /opt/orion/%i/service.env (WEB_HOST, WEB_PORT).
[Unit]
Description=ORIONMARKETS web (%i)
After=network-online.target orion-api@%i.service

[Service]
WorkingDirectory=/opt/orion/%i/repo/apps/web
EnvironmentFile=/opt/orion/%i/service.env
ExecStart=/usr/bin/env pnpm exec next start -H ${WEB_HOST} -p ${WEB_PORT}
Restart=always
RestartSec=5
User=orion

[Install]
WantedBy=multi-user.target
